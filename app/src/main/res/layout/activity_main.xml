<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:id="@+id/main"
    android:background="@drawable/gradient_background">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/myCard"
        android:layout_width="326dp"
        android:layout_height="457dp"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:strokeColor="@color/blueterang"
        app:strokeWidth="1dp"
        app:cardBackgroundColor="@android:color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


    <!-- ISI CARD -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"

            >

            <!-- Text di atas -->

            <!-- TextField Username -->

            <TextView
                android:id="@+id/textView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="100dp"
                android:text="Silahkan login untuk melanjutkan"
                android:textColor="@color/abuabu"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textView3"
                android:layout_width="210dp"
                android:layout_height="24dp"
                android:layout_marginBottom="4dp"
                android:text="DNA MONITORING"
                android:gravity="center"
                android:textStyle="bold"
                android:textColor="@color/darkblue"
                android:textSize="16sp"
                app:layout_constraintBottom_toTopOf="@+id/textView"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <ImageView
                android:id="@+id/dnaLogo"
                android:layout_width="130dp"
                android:layout_height="70dp"
                android:layout_marginBottom="28dp"
                android:scaleType="centerCrop"
                android:src="@drawable/logodna"
                app:layout_constraintBottom_toTopOf="@+id/textView"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/field_userName"
                android:layout_width="299dp"
                android:layout_height="58dp"
                app:boxBackgroundColor="@color/gray"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusBottomEnd="9dp"
                app:boxCornerRadiusBottomStart="9dp"
                app:boxCornerRadiusTopEnd="9dp"
                app:boxCornerRadiusTopStart="9dp"
                app:boxStrokeColor="@color/blue"
                app:boxStrokeWidth="2dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.417">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/Username"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Masukan Username" />

            </com.google.android.material.textfield.TextInputLayout>


            <!--            Text field Password-->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/field_password"
                android:layout_width="299dp"
                android:layout_height="58dp"
                android:layout_marginTop="37dp"
                app:boxBackgroundColor="@color/gray"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusBottomEnd="9dp"
                app:boxCornerRadiusBottomStart="9dp"
                app:boxCornerRadiusTopEnd="9dp"
                app:boxCornerRadiusTopStart="9dp"
                app:boxStrokeColor="@color/blue"
                app:boxStrokeWidth="2dp"
                app:endIconMode="password_toggle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/field_userName"
                app:layout_constraintVertical_bias="0.417">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/Password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Masukan Password"
                    android:inputType="textPassword" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Username"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@+id/field_userName"
                app:layout_constraintStart_toStartOf="@+id/field_userName" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Password"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@+id/field_password"
                app:layout_constraintStart_toStartOf="@+id/field_password" />

            <!--            Button login -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/Login"
                android:layout_width="299dp"
                android:layout_height="49dp"
                android:layout_marginTop="30dp"
                android:text="Login"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/blue"
                app:cornerRadius="10dp"
                app:layout_constraintStart_toStartOf="@id/field_password"
                app:layout_constraintTop_toBottomOf="@id/field_password" />


        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
