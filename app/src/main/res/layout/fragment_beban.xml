<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navbar"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:openDrawer="start">

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <!--Scroll-->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/main"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Judul -->
                <TextView
                    android:id="@+id/bebankerja"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="15dp"
                    android:text="Beban Kerja"
                    android:textColor="@color/darkblue"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/Keloladanpantau"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="24dp"
                    android:text="Pantau dan kelola beban kerja karyawan"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/bebankerja" />

                <!-- Filter Card Responsive -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/filterCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="@color/white"
                    app:cardElevation="6dp"
                    app:cardUseCompatPadding="true"
                    app:strokeColor="@color/blueterang12"
                    app:strokeWidth="1dp"
                    app:layout_constraintTop_toBottomOf="@id/Keloladanpantau"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp">

                        <!-- Icon Search -->
                        <ImageView
                            android:id="@+id/searchIcon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/filter"
                            app:tint="@color/darkblue"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent" />

                        <!-- Text Filter -->
                        <TextView
                            android:id="@+id/searchText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Filter pencarian"
                            android:textColor="@color/darkblue"
                            android:textSize="16sp"
                            app:layout_constraintStart_toEndOf="@id/searchIcon"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@id/searchIcon"
                            app:layout_constraintBottom_toBottomOf="@id/searchIcon" />

                        <!-- Rentang Tanggal Mulai -->

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/dateLayout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:hint="Tanggal Mulai"
                            app:boxBackgroundColor="@color/gray"
                            app:boxBackgroundMode="outline"
                            app:boxCornerRadiusTopStart="9dp"
                            app:boxCornerRadiusTopEnd="9dp"
                            app:boxCornerRadiusBottomStart="9dp"
                            app:boxCornerRadiusBottomEnd="9dp"
                            app:boxStrokeColor="@color/blue"
                            app:endIconTint="@color/darkblue"
                            app:startIconDrawable="@drawable/calender"
                            app:layout_constraintTop_toBottomOf="@id/searchIcon"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">


                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/dateInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clickable="false"
                                android:cursorVisible="false"
                                android:focusable="false"
                                android:inputType="none"
                                android:paddingVertical="8dp"
                                android:textSize="16sp" />
                        </com.google.android.material.textfield.TextInputLayout>



                        <!-- Rentang Tanggal Akhir -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/dateLayout_akhir"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:hint="Tanggal Akhir"
                            app:boxBackgroundColor="@color/gray"
                            app:boxBackgroundMode="outline"
                            app:boxCornerRadiusTopStart="9dp"
                            app:boxCornerRadiusTopEnd="9dp"
                            app:boxCornerRadiusBottomStart="9dp"
                            app:boxCornerRadiusBottomEnd="9dp"
                            app:boxStrokeColor="@color/blue"
                            app:endIconTint="@color/darkblue"
                            app:startIconDrawable="@drawable/calender"
                            app:layout_constraintTop_toBottomOf="@id/dateLayout"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/dateInput_akhir"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clickable="false"
                                android:cursorVisible="false"
                                android:focusable="false"
                                android:inputType="none"
                                android:paddingVertical="8dp"
                                android:textSize="16sp" />
                        </com.google.android.material.textfield.TextInputLayout>



                        <!-- Input Cari Nama Karyawan -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/namaKaryawan"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            app:boxBackgroundColor="@color/gray"
                            app:boxBackgroundMode="outline"
                            app:boxCornerRadiusTopStart="9dp"
                            app:boxCornerRadiusTopEnd="9dp"
                            app:boxCornerRadiusBottomStart="9dp"
                            app:boxCornerRadiusBottomEnd="9dp"
                            app:boxStrokeColor="@color/blue"
                            app:startIconDrawable="@drawable/srcicon"
                            app:layout_constraintTop_toBottomOf="@id/spinner_status"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">

                            <AutoCompleteTextView
                                android:id="@+id/cariNama"
                                android:inputType="text"
                                android:maxLines="1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Cari nama karyawan" android:padding="10dp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Dropdown Posisi -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/spinner"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            app:boxBackgroundColor="@color/gray"
                            app:boxBackgroundMode="outline"
                            app:boxCornerRadiusTopStart="9dp"
                            app:boxCornerRadiusTopEnd="9dp"
                            app:boxCornerRadiusBottomStart="9dp"
                            app:boxCornerRadiusBottomEnd="9dp"
                            app:boxStrokeColor="@color/blue"
                            app:endIconMode="dropdown_menu"
                            app:layout_constraintTop_toBottomOf="@id/dateLayout_akhir"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">

                            <AutoCompleteTextView
                                android:id="@+id/autoCompleteRoles"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Posisi Karyawan"
                                android:padding="10dp" />

                        </com.google.android.material.textfield.TextInputLayout>


                        <!-- Dropdown Posisi -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/spinner_status"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            app:boxBackgroundColor="@color/gray"
                            app:boxBackgroundMode="outline"
                            app:boxCornerRadiusTopStart="9dp"
                            app:boxCornerRadiusTopEnd="9dp"
                            app:boxCornerRadiusBottomStart="9dp"
                            app:boxCornerRadiusBottomEnd="9dp"
                            app:boxStrokeColor="@color/blue"
                            app:endIconMode="dropdown_menu"
                            app:layout_constraintTop_toBottomOf="@id/spinner"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">

                            <AutoCompleteTextView
                                android:id="@+id/indicator_karyawan"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Status Karyawan"
                                android:padding="10dp" />
                        </com.google.android.material.textfield.TextInputLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycleViews_bebankerja"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:layout_marginBottom="2dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/filterCard" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvkaryawan"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="2dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/recycleViews_bebankerja" />


            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>

    </FrameLayout>

</androidx.drawerlayout.widget.DrawerLayout>