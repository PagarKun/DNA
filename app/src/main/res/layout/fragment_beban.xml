<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navbar"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:openDrawer="start">

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!--Scroll-->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">



            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/main"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Judul -->
                <TextView
                    android:id="@+id/bebankerja"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="15dp"
                    android:text="Beban Kerja"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/darkblue"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/Keloladanpantau"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="24dp"
                    android:text="Pantau dan kelola beban kerja karyawan"
                    android:textSize="16sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/bebankerja"/>

                <!-- Filter Card Responsive -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/filterCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="24dp"
                    android:backgroundTint="@color/white"
                    app:cardUseCompatPadding="true"
                    app:cardElevation="6dp"
                    app:strokeColor="@color/blueterang12"
                    app:strokeWidth="1dp"
                    app:layout_constraintTop_toBottomOf="@+id/Keloladanpantau"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp">

                        <ImageView
                            android:id="@+id/searchIcon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/filter"
                            app:tint="@color/darkblue"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent" />

                        <TextView
                            android:id="@+id/searchText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Filter  pencarian"
                            android:textSize="16sp"
                            android:textColor="@color/darkblue"
                            android:layout_marginStart="12dp"
                            app:layout_constraintStart_toEndOf="@id/searchIcon"
                            app:layout_constraintTop_toTopOf="@id/searchIcon"
                            app:layout_constraintBottom_toBottomOf="@id/searchIcon"/>

                        <!-- Input Cari -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/namaKaryawan"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            app:boxBackgroundColor="@color/gray"
                            app:boxBackgroundMode="outline"
                            app:boxCornerRadiusTopStart="9dp"
                            app:boxCornerRadiusTopEnd="9dp"
                            app:boxCornerRadiusBottomStart="9dp"
                            app:boxCornerRadiusBottomEnd="9dp"
                            app:boxStrokeColor="@color/blue"
                            app:startIconDrawable="@drawable/srcicon"
                            app:layout_constraintTop_toBottomOf="@id/searchText"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">

                            <com.google.android.material.textfield.TextInputEditText
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Cari nama karyawan"
                                android:padding="10dp"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Dropdown -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/spinner"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            app:endIconMode="dropdown_menu"
                            app:boxBackgroundColor="@color/gray"
                            app:boxBackgroundMode="outline"
                            app:boxCornerRadiusTopStart="9dp"
                            app:boxCornerRadiusTopEnd="9dp"
                            app:boxCornerRadiusBottomStart="9dp"
                            app:boxCornerRadiusBottomEnd="9dp"
                            app:layout_constraintTop_toBottomOf="@id/namaKaryawan"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">

                            <AutoCompleteTextView
                                android:id="@+id/autoCompleteRoles"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Posisi"
                                android:padding="10dp"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Card Jumlah -->


                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>




                <!-- RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycleViews"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/filterCard"/>


            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

    </FrameLayout>

</androidx.drawerlayout.widget.DrawerLayout>