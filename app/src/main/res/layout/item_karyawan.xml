<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="10dp"
    android:backgroundTint="@color/white2"
    app:strokeColor="@color/blueterang12"
    app:strokeWidth="1dp"
    app:cardElevation="8dp"
    app:cardUseCompatPadding="true"
    android:id="@+id/card_karyawan">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Foto Profil -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/profileImage"
            android:padding="2dp"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:scaleType="centerCrop"
            android:src="@drawable/profile"
            android:clipToOutline="true"
            app:strokeWidth="1dp"
            app:strokeColor="@color/blueterang"
            app:shapeAppearanceOverlay="@style/CircleImage"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Nama -->
        <TextView
            android:id="@+id/namakaryawan2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nama Karyawan"
            android:textSize="18sp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/profileImage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:textColor="@color/darkblue"/>

        <!-- Keahlian -->
        <TextView
            android:id="@+id/keahlian"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Designer"
            android:textSize="14sp"
            android:textColor="@color/abuabu"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/namakaryawan2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Garis -->
        <View
            android:id="@+id/garis"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#D9D9D9"
            app:layout_constraintTop_toBottomOf="@id/keahlian"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Label Proyek Aktif -->
        <TextView
            android:id="@+id/Label_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status Karyawan"
            android:layout_marginTop="15dp"
            app:layout_constraintTop_toBottomOf="@id/garis"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Status Karyawan -->
        <TextView
            android:id="@+id/Status_karyawan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tidak Diketahui"
            android:textSize="16sp"
            android:textColor="@color/darkblue"
            app:layout_constraintTop_toTopOf="@id/Label_status"
            app:layout_constraintBottom_toBottomOf="@id/Label_status"
            app:layout_constraintEnd_toEndOf="parent"/>


    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>