<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="24dp"
    android:layout_marginEnd="24dp"
    android:layout_marginBottom="10dp"
    android:backgroundTint="@color/white2"
    app:strokeColor="@color/blueterang12"
    app:strokeWidth="1dp"
    app:cardUseCompatPadding="true"
    android:id="@+id/card_karyawan">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Foto Profil -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/profileImage"
            android:padding="2dp"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:scaleType="centerCrop"
            android:src="@drawable/profile"
            android:clipToOutline="true"
            app:strokeWidth="1dp"
            app:strokeColor="@color/blueterang"
            app:shapeAppearanceOverlay="@style/CircleImage"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Nama -->
        <TextView
            android:id="@+id/namakaryawan2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Budiono Siregar"
            android:textSize="18sp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/profileImage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:textColor="@color/darkblue"/>

        <!-- Keahlian -->
        <TextView
            android:id="@+id/keahlian"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Designer"
            android:textSize="14sp"
            android:textColor="@color/abuabu"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/namakaryawan2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Garis -->
        <View
            android:id="@+id/garis"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#D9D9D9"
            app:layout_constraintTop_toBottomOf="@id/keahlian"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Label Proyek Aktif -->
        <TextView
            android:id="@+id/proyekAktif"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Proyek Aktif"
            android:layout_marginTop="15dp"
            app:layout_constraintTop_toBottomOf="@id/garis"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Jumlah Proyek Aktif -->
        <TextView
            android:id="@+id/angkaProyek"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12"
            android:textSize="16sp"
            android:textColor="@color/darkblue"
            app:layout_constraintTop_toTopOf="@id/proyekAktif"
            app:layout_constraintBottom_toBottomOf="@id/proyekAktif"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Label Performa -->
        <TextView
            android:id="@+id/performa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Performa"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/proyekAktif"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Angka Performa (%) -->
        <TextView
            android:id="@+id/angkaPerforma"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="87%"
            android:textColor="@color/darkblue"
            android:textSize="16sp"
            app:layout_constraintTop_toTopOf="@id/performa"
            app:layout_constraintBottom_toBottomOf="@id/performa"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>